#!/usr/bin/env node
/**
 * Uploads all local images from images/ to Supabase Storage bucket "product-images".
 * Then updates product_images.image_url to the Supabase public URL.
 */
import { readFileSync, readdirSync, statSync } from 'node:fs';
import path from 'node:path';
import { createClient } from '@supabase/supabase-js';

const env = readFileSync('.env', 'utf8');
const url = env.match(/VITE_SUPABASE_URL=(.+)/)?.[1]?.trim();
const key = env.match(/VITE_SUPABASE_ANON_KEY=(.+)/)?.[1]?.trim();
const supabase = createClient(url, key);

const BUCKET = 'product-images';
const LOCAL_DIR = 'images';
const CONCURRENCY = 5;

// Step 1: Build list of all local image files
const uploadList = [];
const refs = readdirSync(LOCAL_DIR);
for (const ref of refs) {
  const refPath = path.join(LOCAL_DIR, ref);
  if (!statSync(refPath).isDirectory()) continue;
  const files = readdirSync(refPath);
  for (const f of files) {
    if (f.startsWith('.')) continue;
    const localPath = path.join(refPath, f);
    const storagePath = `${ref}/${f}`;
    uploadList.push({ ref, file: f, localPath, storagePath });
  }
}
console.log(`Found ${uploadList.length} local images to upload.`);

// Step 2: Upload to Supabase Storage
let uploaded = 0, uploadErrors = 0;
const results = [];

async function uploadOne(item) {
  const fileBuffer = readFileSync(item.localPath);
  const { error } = await supabase.storage
    .from(BUCKET)
    .upload(item.storagePath, fileBuffer, { upsert: true, contentType: getContentType(item.file) });
  if (error) {
    uploadErrors++;
    console.error(`Upload err ${item.storagePath}: ${error.message}`);
  } else {
    uploaded++;
    const { data: pubData } = supabase.storage.from(BUCKET).getPublicUrl(item.storagePath);
    results.push({ ref: item.ref, file: item.file, publicUrl: pubData.publicUrl });
  }
  process.stdout.write(`\r${uploaded} uploaded, ${uploadErrors} errors, ${results.length}/${uploadList.length}`);
}

function getContentType(filename) {
  const ext = path.extname(filename).toLowerCase();
  const types = { '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg', '.png': 'image/png', '.webp': 'image/webp', '.gif': 'image/gif', '.avif': 'image/avif' };
  return types[ext] || 'application/octet-stream';
}

// Worker pool
const queue = [...uploadList];
async function worker() {
  while (queue.length) {
    await uploadOne(queue.shift());
  }
}
await Promise.all(Array.from({ length: CONCURRENCY }, () => worker()));
console.log(`\nUpload done: ${uploaded} success, ${uploadErrors} errors.`);

// Step 3: Query database to get all product_images records
console.log('Fetching product_images from database...');
const allImages = [];
let from = 0;
while (true) {
  const { data, error } = await supabase.from('product_images').select('id,numref,image_url,image_number').range(from, from + 999);
  if (error) { console.error('Query error:', error); break; }
  if (!data || data.length === 0) break;
  allImages.push(...data);
  if (data.length < 1000) break;
  from += 1000;
}
console.log(`Found ${allImages.length} image records in database.`);

// Step 4: Build mapping from (ref, image_number) -> publicUrl
// The local files are named <ref>_<n>.<ext>, and image_number in DB corresponds to n
const urlMap = new Map();
for (const r of results) {
  const m = r.file.match(/^(.+)_(\d+)\./);
  if (m) {
    const ref = m[1];
    const imgNum = parseInt(m[2]);
    urlMap.set(`${ref}_${imgNum}`, r.publicUrl);
  }
}

// Step 5: Update database records
console.log('Updating database image_url to Supabase Storage URLs...');
let updated = 0, dbErrors = 0, noMatch = 0;
const BATCH = 50;
const updates = [];

for (const img of allImages) {
  const safeRef = String(img.numref).replace(/[^\w.\-]/g, '_');
  const key = `${safeRef}_${img.image_number}`;
  const newUrl = urlMap.get(key);
  if (newUrl && newUrl !== img.image_url) {
    updates.push({ id: img.id, url: newUrl });
  } else if (!newUrl) {
    noMatch++;
  }
}

console.log(`${updates.length} records to update, ${noMatch} with no matching local file.`);

for (let i = 0; i < updates.length; i += BATCH) {
  const batch = updates.slice(i, i + BATCH);
  const promises = batch.map(u =>
    supabase.from('product_images').update({ image_url: u.url }).eq('id', u.id)
      .then(({ error }) => { if (error) { dbErrors++; console.error(`DB err ${u.id}: ${error.message}`); } else updated++; })
  );
  await Promise.all(promises);
  process.stdout.write(`\r${updated} updated, ${dbErrors} errors, ${i + batch.length}/${updates.length}`);
}
console.log(`\nDatabase updated: ${updated} success, ${dbErrors} errors.`);
